                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 * main.asm
                                 *
                                 * Creado: 3/3/26
                                 * Autor : Diego Samayoa
                                 * Descripción: Reloj digital
                                 */
                                 /****************************************/
                                 // Encabezado (Definición de Registros, Variables y Constantes)
                                 .include "M328PDEF.inc"     // Include definitions specific to ATMega328P
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 .dseg
                                 .org    SRAM_START
                                 //variable_name:     .byte   1   // Memory alocation for variable_name:     .byte   (byte size)
                                 
                                 // variables para el reloj
000100                           t_1s: .byte 1	// flag al llegar a 1s
                                 
                                 // variables para blink por software con Timer0
000101                           blinkL:     .byte 1     // low byte contador para 500ms
000102                           blinkH:     .byte 1     // high byte contador para 500ms
000103                           blink_500:  .byte 1     // toggle cada 500ms
000104                           halfsec:    .byte 1     // cuenta dos medios segundos para formar 1s
                                 
                                 // variable para antirebote por software
000105                           debounce_lock: .byte 1
                                 
                                 // variable para guardar ultimo estado de botones
000106                           boton_last: .byte 1
                                 
                                 // digitos del reloj
000107                           seg:            .byte 1
000108                           min_uni:        .byte 1
000109                           min_dec:        .byte 1
00010a                           hora_uni:       .byte 1
00010b                           hora_dec:       .byte 1
                                 
                                 // digitos de la fecha
00010c                           dia_uni:        .byte 1
00010d                           dia_dec:        .byte 1
00010e                           mes_uni:        .byte 1
00010f                           mes_dec:        .byte 1
                                 
                                 // digitos de la alarma
000110                           alarm_min_uni:  .byte 1
000111                           alarm_min_dec:  .byte 1
000112                           alarm_hora_uni: .byte 1
000113                           alarm_hora_dec: .byte 1
000114                           alarm_on:       .byte 1
                                 
                                 // indica que digito del display esta seleccionado
000115                           digito:    .byte 1
                                 
                                 //botones y modo
000116                           boton:  .byte 1
000117                           mode:   .byte 1   ; 0=hora 1=dia 2=alarma
                                 
                                 // configuracion
000118                           config_mode:    .byte 1   ; 0=normal 1=configurando
000119                           edit_pos:       .byte 1   ; 0=no edita 1..4 digito que se edita
                                 
                                 .cseg
                                 .org 0x0000
000000 c021                      	RJMP START
                                 
                                 .org	PCI0addr // Interrupcion de pinchange para el puerto B
000006 c44a                      	RJMP		PINB_ISR
                                 
                                 .org	OC0Aaddr// interrupcion timer 0 compare match A
00001c c440                      	RJMP		TIMER0_ISR
                                 
                                 
                                 table_S7:
00001d 063f
00001e 4f5b
00001f 6d66
000020 077d
000021 6f7f                      .DB 0x3F,0x06,0x5B,0x4F,0x66,0x6D,0x7D,0x07,0x7F,0x6F
                                 
                                  /****************************************/
                                  START:
                                 // Configuración de la pila
000022 ef0f                      LDI     R16, LOW(RAMEND)
000023 bf0d                      OUT     SPL, R16
000024 e008                      LDI     R16, HIGH(RAMEND)
000025 bf0e                      OUT     SPH, R16
                                 
                                 /****************************************/
                                 // Configuracion MCU
                                 SETUP:
000026 94f8                      CLI
                                 
                                 	// salidas para el display y led de fecha
000027 ef0f                      ldi r16, 0b11111111
000028 b90a                      out DDRD, r16
000029 2700                      clr r16
00002a b90b                      out PORTD,r16
                                 
                                 	// salidas para digitos del display C1-C5
00002b e30e                      LDI R16,0b00111110
00002c b907                      OUT DDRC,R16
00002d 2700                      CLR R16
00002e b908                      OUT PORTC,R16
                                 
                                 	//Leds para señalar y buzzer
00002f e300                      ldi r16, 0b00110000
000030 b904                      out DDRB, r16	
                                 	
                                 	// botones pb0-pb3
000031 e00f                      ldi r16, 0x0F
000032 b905                      out PORTB, r16
                                 
                                 	//activar PCINT
000033 e001                      LDI R16,(1<<PCIE0)
000034 9300 0068                 STS PCICR,R16
000036 e00f                      LDI R16,0b00001111
000037 9300 006b                 STS PCMSK0,R16
                                 
                                 	//Limpiar RAM
000039 2411                      clr r1
00003a 2700                      clr r16
                                 
00003b 9300 0100                 STS t_1s,R16
                                 
00003d 9300 0101                 STS blinkL,R16
00003f 9300 0102                 STS blinkH,R16
000041 9300 0103                 STS blink_500,R16
000043 9300 0104                 STS halfsec,R16
                                 
000045 9300 0105                 STS debounce_lock,R16
000047 9300 0106                 STS boton_last,R16
                                 
000049 9300 0107                 STS seg,R16
                                 
00004b 9300 0108                 STS min_uni,R16
00004d 9300 0109                 STS min_dec,R16
00004f 9300 010a                 STS hora_uni,R16
000051 9300 010b                 STS hora_dec,R16
                                 
000053 9300 010d                 STS dia_dec,R16
000055 e001                      LDI R16, 1
000056 9300 010c                 STS dia_uni,R16
000058 2700                      CLR R16
000059 9300 010f                 STS mes_dec,R16
00005b e001                      LDI R16, 1
00005c 9300 010e                 STS mes_uni,R16
                                 
00005e e009                      LDI R16, 9
00005f 9300 0110                 STS alarm_min_uni, R16
000061 e005                      LDI R16, 5
000062 9300 0111                 STS alarm_min_dec, R16
000064 e003                      LDI R16, 3
000065 9300 0112                 STS alarm_hora_uni, R16
000067 e002                      LDI R16, 2
000068 9300 0113                 STS alarm_hora_dec, R16
00006a 2700                      CLR R16
00006b 9300 0114                 STS alarm_on, R16
                                 
00006d 9300 0115                 STS digito, R16
00006f 9300 0116                 STS boton, R16
000071 9300 0117                 STS mode, R16
000073 9300 0118                 STS config_mode, R16
000075 9300 0119                 STS edit_pos, R16
                                 
                                 	// guardar estado inicial de botones
000077 b103                      in r16, PINB
000078 9500                      com r16
000079 700f                      andi r16, 0x0F
00007a 9300 0106                 sts boton_last, r16
                                 
                                 	// Configurar timer 0 para que cuente 1ms
00007c e002                      LDI R16,(1<<WGM01)
00007d bd04                      OUT TCCR0A,R16				
00007e e003                      LDI R16,(1<<CS01)|(1<<CS00)
00007f bd05                      OUT TCCR0B,R16
000080 ef09                      LDI R16,249
000081 bd07                      OUT OCR0A,R16
000082 e002                      LDI R16,(1<<OCIE0A)
000083 9300 006e                 STS TIMSK0,R16
                                 
000085 d027                      RCALL actualizar_leds_modo
                                 
000086 9478                      SEI
                                     
                                 /****************************************/
                                 // Loop Infinito
                                 MAIN_LOOP:
                                 	// revisamos botones para modo
000087 9100 0116                 	LDS R16,boton
000089 3000                      	CPI R16,0
00008a f099                      	BREQ check_clk
                                 	
                                 	// si la alarma esta activa, cualquier boton la apaga
00008b 9110 0114                     LDS R17, alarm_on
00008d 3010                          CPI R17, 0
00008e f021                          BREQ procesar_botones
                                 
00008f 2711                      	CLR R17
000090 9310 0114                     STS alarm_on, R17
000092 982d                          CBI PORTB, 5
                                 
                                 procesar_botones:
                                 	
                                 	// B0 modo configuracion / siguiente digito
000093 fd00                          SBRC R16, 0
000094 d037                          RCALL boton_config
                                 
                                     // B1 cambiar modo mostrado 
000095 fd01                          SBRC R16, 1
000096 d051                          RCALL boton_modo
                                 
                                     // B2 incremento
000097 fd02                          SBRC R16, 2
000098 d055                          RCALL boton_inc
                                 
                                     // B3 decremento
000099 fd03                          SBRC R16, 3
00009a d061                          RCALL boton_dec
                                 
                                 limpiar_bot:
00009b 2700                          CLR R16
00009c 9300 0116                     STS boton,R16
                                 
                                 check_clk:
00009e 9100 0100                     LDS R16,t_1s
0000a0 3000                          CPI R16,0
0000a1 f329                          BREQ MAIN_LOOP
                                 
0000a2 2700                          CLR R16
0000a3 9300 0100                     STS t_1s,R16
                                 
                                     // solo actualizar reloj cuando no se esta configurando
0000a5 9110 0119                     LDS R17,edit_pos
0000a7 3010                          CPI R17,0
0000a8 f009                          BREQ seguir_update
0000a9 cfdd                          RJMP MAIN_LOOP
                                 
                                 seguir_update:
0000aa d2ed                          RCALL actualizar_clk
0000ab d384                      	RCALL revisar_alarma
                                 
0000ac cfda                          RJMP    MAIN_LOOP
                                 
                                 /****************************************/
                                 // NON-Interrupt subroutines
                                 
                                 actualizar_leds_modo:
                                 	//Rutina que se va a utilizar para actualizar los leds al modo actual
0000ad 930f                      	PUSH R16
0000ae b70f                          IN   R16, SREG
0000af 930f                          PUSH R16
                                 
                                     // apagar ambos leds
0000b0 982c                          CBI PORTB,4
0000b1 985f                          CBI PORTD,7
                                 
0000b2 9100 0117                     LDS R16,mode
0000b4 3000                          CPI R16,0
0000b5 f029                          BREQ led_hora
0000b6 3001                          CPI R16,1
0000b7 f029                          BREQ led_fecha
                                 
                                     // modo alarma (ambos leds encendidos)
0000b8 9a2c                          SBI PORTB,4
0000b9 9a5f                          SBI PORTD,7
0000ba c003                          RJMP fin_leds
                                 
                                 led_hora:
0000bb 9a2c                          SBI PORTB,4
0000bc c001                          RJMP fin_leds
                                 
                                 led_fecha:
0000bd 9a5f                          SBI PORTD,7
                                 
                                 fin_leds:
0000be 910f                          POP R16
0000bf bf0f                          OUT SREG,R16
0000c0 910f                          POP R16
0000c1 9508                          RET
                                 
                                 //Rutina para cambiar modos
                                 cambio_modo:
0000c2 9100 0117                     LDS R16,mode
0000c4 9503                          INC R16
0000c5 3003                          CPI R16,3
0000c6 f008                          BRLO guardar_modo
0000c7 2700                          CLR R16
                                 guardar_modo:
0000c8 9300 0117                     STS mode,R16
0000ca dfe2                          RCALL actualizar_leds_modo
0000cb 9508                          RET
                                 
                                 // B0: entra a configuracion
                                 boton_config:
0000cc 9100 0119                     LDS R16, edit_pos
0000ce 9503                          INC R16
0000cf 3005                          CPI R16,5
0000d0 f008                          BRLO guardar_edit
                                 
                                     // ya paso del ultimo digito, salir de configuracion
0000d1 2700                          CLR R16
                                 
                                 guardar_edit:
0000d2 9300 0119                     STS edit_pos, R16
                                 
                                     // actualizar flag de configuracion
0000d4 3000                          CPI R16,0
0000d5 f021                          BREQ salir_config
                                 
0000d6 e011                          LDI R17,1
0000d7 9310 0118                     STS config_mode,R17
0000d9 c003                          RJMP reset_blink_conf
                                 
                                 salir_config:
0000da 2711                          CLR R17
0000db 9310 0118                     STS config_mode,R17
                                 
                                 reset_blink_conf:
                                     // reiniciar multiplexado y blink para que se note de inmediato
0000dd e013                          LDI R17,3
0000de 9310 0115                     STS digito,R17
                                 
0000e0 2711                          CLR R17
0000e1 9310 0101                     STS blinkL,R17
0000e3 9310 0102                     STS blinkH,R17
0000e5 9310 0103                     STS blink_500,R17
0000e7 9508                          RET
                                 
                                 // B1: cambia modo solo cuando no esta en modo de configuracion
                                 boton_modo:
0000e8 9100 0119                     LDS R16, edit_pos
0000ea 3000                          CPI R16, 0
0000eb f409                          BRNE fin_boton_modo
0000ec dfd5                          RCALL cambio_modo
                                 fin_boton_modo:
0000ed 9508                          RET
                                 
                                 // B2: incrementa digito seleccionado
                                 boton_inc:
0000ee 9100 0119                     LDS R16, edit_pos
0000f0 3000                          CPI R16, 0
0000f1 f049                          BREQ fin_boton_inc
                                 
0000f2 9100 0117                     LDS R16, mode
0000f4 3000                          CPI R16, 0
0000f5 f409                          BRNE boton_inc_chk1
0000f6 c013                          RJMP inc_hora
                                 //Esto es necesario porque la subrutina a la que nos referimos esta muy lejos
                                 boton_inc_chk1:
0000f7 3001                          CPI R16, 1
0000f8 f409                          BRNE boton_inc_chk2
0000f9 c09b                          RJMP inc_fecha
                                 
                                 boton_inc_chk2:
0000fa c104                          RJMP inc_alarma
                                 
                                 fin_boton_inc:
0000fb 9508                          RET
                                 
                                 // B3: decrementa digito seleccionado
                                 boton_dec:
0000fc 9100 0119                     LDS R16, edit_pos
0000fe 3000                          CPI R16, 0
0000ff f049                          BREQ fin_boton_dec
                                 
000100 9100 0117                     LDS R16, mode
000102 3000                          CPI R16, 0
000103 f409                          BRNE boton_dec_chk1
000104 c042                          RJMP dec_hora
                                 //Esto es necesario porque la subrutina a la que nos referimos esta muy lejos
                                 boton_dec_chk1:
000105 3001                          CPI R16, 1
000106 f409                          BRNE boton_dec_chk2
000107 c0c0                          RJMP dec_fecha
                                 
                                 boton_dec_chk2:
000108 c133                          RJMP dec_alarma
                                 
                                 fin_boton_dec:
000109 9508                          RET
                                 
                                 
                                 //Incremento de hora actual
                                 inc_hora:
00010a 9100 0119                     LDS R16, edit_pos
00010c 3001                          CPI R16,1
00010d f039                          BREQ inc_hora_dec
00010e 3002                          CPI R16,2
00010f f079                          BREQ inc_hora_uni
000110 3003                          CPI R16,3
000111 f119                          BREQ inc_min_dec
000112 3004                          CPI R16,4
000113 f151                          BREQ inc_min_uni
000114 9508                          RET
                                 
                                 inc_hora_dec:
000115 9100 010b                     LDS R16,hora_dec
000117 9503                          INC R16
000118 3003                          CPI R16,3
000119 f008                          BRLO save_inc_hora_dec
00011a 2700                          CLR R16
                                 save_inc_hora_dec:
00011b 9300 010b                     STS hora_dec,R16
00011d d06b                          RCALL ajustar_hora_actual
00011e 9508                          RET
                                 
                                 inc_hora_uni:
00011f 9100 010b                     LDS R16,hora_dec
000121 3002                          CPI R16,2
000122 f449                          BRNE inc_hora_uni_normal
                                 
000123 9100 010a                     LDS R16,hora_uni
000125 9503                          INC R16
000126 3004                          CPI R16,4
000127 f008                          BRLO save_inc_hora_uni_24
000128 2700                          CLR R16
                                 save_inc_hora_uni_24:
000129 9300 010a                     STS hora_uni,R16
00012b 9508                          RET
                                 
                                 inc_hora_uni_normal:
00012c 9100 010a                     LDS R16,hora_uni
00012e 9503                          INC R16
00012f 300a                          CPI R16,10
000130 f008                          BRLO save_inc_hora_uni
000131 2700                          CLR R16
                                 save_inc_hora_uni:
000132 9300 010a                     STS hora_uni,R16
000134 9508                          RET
                                 
                                 inc_min_dec:
000135 9100 0109                     LDS R16,min_dec
000137 9503                          INC R16
000138 3006                          CPI R16,6
000139 f008                          BRLO save_inc_min_dec
00013a 2700                          CLR R16
                                 save_inc_min_dec:
00013b 9300 0109                     STS min_dec,R16
00013d 9508                          RET
                                 
                                 inc_min_uni:
00013e 9100 0108                     LDS R16,min_uni
000140 9503                          INC R16
000141 300a                          CPI R16,10
000142 f008                          BRLO save_inc_min_uni
000143 2700                          CLR R16
                                 save_inc_min_uni:
000144 9300 0108                     STS min_uni,R16
000146 9508                          RET
                                 
                                 //Decremento de hora actual
                                 dec_hora:
000147 9100 0119                     LDS R16, edit_pos
000149 3001                          CPI R16,1
00014a f039                          BREQ dec_hora_dec
00014b 3002                          CPI R16,2
00014c f081                          BREQ dec_hora_uni
00014d 3003                          CPI R16,3
00014e f131                          BREQ dec_min_dec
00014f 3004                          CPI R16,4
000150 f171                          BREQ dec_min_uni
000151 9508                          RET
                                 
                                 dec_hora_dec:
000152 9100 010b                     LDS R16,hora_dec
000154 3000                          CPI R16,0
000155 f411                          BRNE dec_hora_dec_normal
000156 e002                          LDI R16,2
000157 c001                          RJMP save_dec_hora_dec
                                 
                                 dec_hora_dec_normal:
000158 950a                          DEC R16
                                 
                                 save_dec_hora_dec:
000159 9300 010b                     STS hora_dec,R16
00015b d02d                          RCALL ajustar_hora_actual
00015c 9508                          RET
                                 
                                 dec_hora_uni:
00015d 9100 010b                     LDS R16,hora_dec
00015f 3002                          CPI R16,2
000160 f451                          BRNE dec_hora_uni_normal
                                 
000161 9100 010a                     LDS R16,hora_uni
000163 3000                          CPI R16,0
000164 f411                          BRNE dec_hora_uni_24
000165 e003                          LDI R16,3
000166 c001                          RJMP save_dec_hora_uni_24
                                 
                                 dec_hora_uni_24:
000167 950a                          DEC R16
                                 
                                 save_dec_hora_uni_24:
000168 9300 010a                     STS hora_uni,R16
00016a 9508                          RET
                                 
                                 dec_hora_uni_normal:
00016b 9100 010a                     LDS R16,hora_uni
00016d 3000                          CPI R16,0
00016e f411                          BRNE dec_hora_uni_norm2
00016f e009                          LDI R16,9
000170 c001                          RJMP save_dec_hora_uni
                                 
                                 dec_hora_uni_norm2:
000171 950a                          DEC R16
                                 
                                 save_dec_hora_uni:
000172 9300 010a                     STS hora_uni,R16
000174 9508                          RET
                                 
                                 dec_min_dec:
000175 9100 0109                     LDS R16,min_dec
000177 3000                          CPI R16,0
000178 f411                          BRNE dec_min_dec_normal
000179 e005                          LDI R16,5
00017a c001                          RJMP save_dec_min_dec
                                 
                                 dec_min_dec_normal:
00017b 950a                          DEC R16
                                 
                                 save_dec_min_dec:
00017c 9300 0109                     STS min_dec,R16
00017e 9508                          RET
                                 
                                 dec_min_uni:
00017f 9100 0108                     LDS R16,min_uni
000181 3000                          CPI R16,0
000182 f411                          BRNE dec_min_uni_normal
000183 e009                          LDI R16,9
000184 c001                          RJMP save_dec_min_uni
                                 
                                 dec_min_uni_normal:
