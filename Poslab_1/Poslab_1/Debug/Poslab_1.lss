                                 /****************************************/
                                 // Encabezado (Definición de Registros, Variables y Constantes)
                                 .include "M328PDEF.inc"     // Include definitions specific to ATMega328P
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 .dseg
                                 .org    SRAM_START
                                 //variable_name:     .byte   1   // Memory alocation for variable_name:     .byte   (byte size)
                                 
                                 .cseg
                                 .org 0x0000
                                  /****************************************/
                                 // Configuración de la pila
000000 ef0f                          LDI     R16, LOW(RAMEND)
000001 bf0d                          OUT     SPL, R16
000002 e008                          LDI     R16, HIGH(RAMEND)
000003 bf0e                          OUT     SPH, R16
                                 
                                 /****************************************/
                                 // Configuración MCU
                                 SETUP:
                                     ; ========= INPUTS =========
000004 9852                          CBI     DDRD, DDD2           ; PD2 botón INC1
000005 9853                          CBI     DDRD, DDD3           ; PD3 botón DEC1
000006 9824                          CBI     DDRB, DDB4           ; PB4 botón INC2
000007 9825                          CBI     DDRB, DDB5           ; PB5 botón DEC2
000008 983d                          CBI     DDRC, DDC5           ; PC5 botón SUMA
                                 
                                     ; ========= OUTPUTS =========
000009 9a54                          SBI     DDRD, DDD4           ; PD4..PD7 LEDs contador 1
00000a 9a55                          SBI     DDRD, DDD5
00000b 9a56                          SBI     DDRD, DDD6
00000c 9a57                          SBI     DDRD, DDD7
                                 
00000d 9a20                          SBI     DDRB, DDB0           ; PB0..PB3 LEDs contador 2
00000e 9a21                          SBI     DDRB, DDB1
00000f 9a22                          SBI     DDRB, DDB2
000010 9a23                          SBI     DDRB, DDB3
                                 
000011 9a38                          SBI     DDRC, DDC0           ; PC0..PC3 LEDs sumador
000012 9a39                          SBI     DDRC, DDC1
000013 9a3a                          SBI     DDRC, DDC2
000014 9a3b                          SBI     DDRC, DDC3
000015 9a3c                          SBI     DDRC, DDC4           ; PC4 LED overflow
                                 
                                     ; ========= LIMPIAR SALIDAS =========
000016 e000                          LDI     R16, 0x00
000017 b905                          OUT     PORTB, R16
000018 b908                          OUT     PORTC, R16
000019 b90b                          OUT     PORTD, R16
                                 
                                     ; ========= PULL-UPS =========
00001a 9a5a                          SBI     PORTD, PORTD2        ; pull-up PD2
00001b 9a5b                          SBI     PORTD, PORTD3        ; pull-up PD3
00001c 9a2c                          SBI     PORTB, PORTB4        ; pull-up PB4
00001d 9a2d                          SBI     PORTB, PORTB5        ; pull-up PB5
00001e 9a45                          SBI     PORTC, PORTC5        ; pull-up PC5
                                 
                                     ; ========= PRESCALER (1 MHz si clock=16MHz) =========
00001f e800                          LDI     R16, (1<<CLKPCE)
000020 9300 0061                     STS     CLKPR, R16
000022 e004                          LDI     R16, 0b00000100      ; /16
000023 9300 0061                     STS     CLKPR, R16
                                 
                                     ; ========= REGISTROS =========
000025 2744                          CLR     R20                  ; contador 1 (0..15)
000026 2755                          CLR     R21                  ; contador 2 (0..15)
000027 2766                          CLR     R22                  ; suma
000028 2700                          CLR     R16
000029 2711                          CLR     R17
00002a 2722                          CLR     R18
00002b 2733                          CLR     R19
00002c 2777                          CLR     R23
00002d 2788                          CLR     R24
00002e 2799                          CLR     R25
                                 
                                 /****************************************/
                                 // Loop Infinito
                                 MAIN_LOOP:
00002f 940e 0036                     CALL    CONT_1
000031 940e 0058                     CALL    CONT_2
000033 940e 0079                     CALL    SUMADOR
000035 cff9                          RJMP    MAIN_LOOP
                                 
                                 /****************************************/
                                 // CONTADOR 1 (PD2 INC, PD3 DEC)  -> LEDs PD4..PD7
                                 CONT_1:
000036 b109                          IN      R16, PIND
000037 700c                          ANDI    R16, 0b00001100      ; aislar PD2,PD3
000038 300c                          CPI     R16, 0b00001100
000039 f049                          BREQ    SHOW_1
                                 
00003a d058                          RCALL   DELAY
                                 
00003b b119                          IN      R17, PIND
00003c 701c                          ANDI    R17, 0b00001100
00003d 1710                          CP      R17, R16
00003e f421                          BRNE    SHOW_1
                                 
00003f ff12                          SBRS    R17, 2               ; si PD2=0 => INC
000040 d00b                          RCALL   INC_1
                                 
000041 ff13                          SBRS    R17, 3               ; si PD3=0 => DEC
000042 d00f                          RCALL   DEC_1
                                 
                                 SHOW_1:
000043 b12b                          IN      R18, PORTD
000044 702f                          ANDI    R18, 0b00001111      ; mantener PD0..PD3 (pullups)
000045 602c                          ORI     R18, 0b00001100      ; asegurar pullups PD2,PD3
                                 
000046 2f34                          MOV     R19, R20
000047 703f                          ANDI    R19, 0b00001111
000048 9532                          SWAP    R19                  ; a nibble alto (PD4..PD7)
000049 2b23                          OR      R18, R19
00004a b92b                          OUT     PORTD, R18
00004b 9508                          RET
                                 
                                 INC_1:
00004c 9543                          INC     R20
00004d 704f                          ANDI    R20, 0b00001111
                                 ANTI_REB_1:
00004e 9b4a                          SBIS    PIND, 2
00004f cffe                          RJMP    ANTI_REB_1
000050 d042                          RCALL   DELAY
000051 9508                          RET
                                 
                                 DEC_1:
000052 954a                          DEC     R20
000053 704f                          ANDI    R20, 0b00001111
                                 ANTI_REB_2:
000054 9b4b                          SBIS    PIND, 3
000055 cffe                          RJMP    ANTI_REB_2
000056 d03c                          RCALL   DELAY
000057 9508                          RET
                                 
                                 /****************************************/
                                 // CONTADOR 2 (PB4 INC, PB5 DEC) -> LEDs PB0..PB3
                                 CONT_2:
000058 b103                          IN      R16, PINB
000059 7300                          ANDI    R16, 0b00110000      ; aislar PB4,PB5
00005a 3300                          CPI     R16, 0b00110000
00005b f049                          BREQ    SHOW_2
                                 
00005c d036                          RCALL   DELAY
                                 
00005d b113                          IN      R17, PINB
00005e 7310                          ANDI    R17, 0b00110000
00005f 1710                          CP      R17, R16
000060 f421                          BRNE    SHOW_2
                                 
000061 ff14                          SBRS    R17, 4               ; PB4=0 => INC
000062 d00a                          RCALL   INC_2
                                 
000063 ff15                          SBRS    R17, 5               ; PB5=0 => DEC
000064 d00e                          RCALL   DEC_2
                                 
                                 SHOW_2:
000065 b125                          IN      R18, PORTB
000066 7f20                          ANDI    R18, 0b11110000      ; mantener nibble alto (pullups PB4,PB5)
000067 6320                          ORI     R18, 0b00110000      ; asegurar pullups PB4,PB5
                                 
000068 2f35                          MOV     R19, R21
000069 703f                          ANDI    R19, 0b00001111
00006a 2b23                          OR      R18, R19             ; mostrar en PB0..PB3
00006b b925                          OUT     PORTB, R18
00006c 9508                          RET
                                 
                                 INC_2:
00006d 9553                          INC     R21
00006e 705f                          ANDI    R21, 0b00001111
                                 ANTI_REB_3:
00006f 9b1c                          SBIS    PINB, 4
000070 cffe                          RJMP    ANTI_REB_3
000071 d021                          RCALL   DELAY
000072 9508                          RET
                                 
                                 DEC_2:
000073 955a                          DEC     R21
000074 705f                          ANDI    R21, 0b00001111
                                 ANTI_REB_4:
000075 9b1d                          SBIS    PINB, 5
000076 cffe                          RJMP    ANTI_REB_4
000077 d01b                          RCALL   DELAY
000078 9508                          RET
                                 
                                 /****************************************/
                                 // SUMADOR (Botón PC5) -> LEDs PC0..PC3, Overflow PC4
                                 SUMADOR:
000079 b106                          IN      R16, PINC
00007a fd05                          SBRC    R16, 5               ; si PC5=1 (no presionado) -> ret
00007b 9508                          RET
                                 
00007c d016                          RCALL   DELAY
                                 
00007d b106                          IN      R16, PINC
00007e fd05                          SBRC    R16, 5
00007f 9508                          RET
                                 
000080 2f64                          MOV     R22, R20
000081 0f65                          ADD     R22, R21
                                 
                                     ; overflow si nibble alto != 0
000082 2f36                          MOV     R19, R22
000083 7f30                          ANDI    R19, 0xF0
000084 3030                          CPI     R19, 0x00
000085 f011                          BREQ    NO_OVER
                                 
000086 9a44                          SBI     PORTC, PORTC4
000087 c001                          RJMP    LED_SUMA
                                 
                                 NO_OVER:
000088 9844                          CBI     PORTC, PORTC4
                                 
                                 LED_SUMA:
000089 b128                          IN      R18, PORTC
00008a 7f20                          ANDI    R18, 0b11110000      ; mantener nibble alto (incluye PC4)
00008b 2f36                          MOV     R19, R22
00008c 703f                          ANDI    R19, 0b00001111
00008d 2b23                          OR      R18, R19
00008e b928                          OUT     PORTC, R18
                                 
                                 ESPERAR_SUMA:
00008f 9b35                          SBIS    PINC, 5              ; esperar a que suelte
000090 cffe                          RJMP    ESPERAR_SUMA
000091 d001                          RCALL   DELAY
000092 9508                          RET
                                 
                                 /****************************************/
                                 // DELAY
                                 DELAY:
000093 e07f                          LDI     R23, 0x0F
                                 DELAY_0:
000094 e08f                          LDI     R24, 0x0F
                                 DELAY_1:
000095 e09f                          LDI     R25, 0x0F
                                 DELAY_2:
000096 959a                          DEC     R25
000097 f7f1                          BRNE    DELAY_2
000098 958a                          DEC     R24
000099 f7d9                          BRNE    DELAY_1
00009a 957a                          DEC     R23
00009b f7c1                          BRNE    DELAY_0


RESOURCE USE INFORMATION
------------------------

Notice:
The register and instruction counts are symbol table hit counts,
and hence implicitly used resources are not counted, eg, the
'lpm' instruction without operands implicitly uses r0 and z,
none of which are counted.

x,y,z are separate entities in the symbol table and are
counted separately from r26..r31 here.

.dseg memory usage only counts static data declared with .byte

